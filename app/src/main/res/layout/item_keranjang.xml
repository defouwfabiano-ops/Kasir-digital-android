<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/card_bg"
    android:layout_marginBottom="5dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_nama_produk_keranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Produk"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tv_harga_keranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:layout_marginTop="3dp" />

        <TextView
            android:id="@+id/tv_subtotal_keranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subtotal: Rp 0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginLeft="10dp">

        <ImageButton
            android:id="@+id/btn_minus_keranjang"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/btn_bg_secondary"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_delete"
            android:contentDescription="Minus"
            android:layout_marginRight="5dp" />

        <TextView
            android:id="@+id/tv_quantity_keranjang"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/btn_plus_keranjang"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/btn_bg_primary"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Plus"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="10dp" />

        <ImageButton
            android:id="@+id/btn_remove_keranjang"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/btn_bg_danger"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_delete"
            android:contentDescription="Remove" />
    </LinearLayout>

</LinearLayout>
